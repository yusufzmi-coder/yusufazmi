APP_NAME="Jadual Kelas Student Auto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ms_MY
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=jadual
DB_USERNAME=jadual
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="admin@jadual.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Admin pertama ---
# Digunakan SEKALI pada deploy pertama untuk mencipta Super Admin. Diabaikan sebaik
# sahaja ada pengguna, jadi redeploy tidak akan menghidupkan semula akaun yang dibuang.
ADMIN_NAME="Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Google Sign-In (Fasa 1) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- Sendscape (Fasa 6) ---
SENDSCAPE_API_KEY=
SENDSCAPE_FROM_ADDRESS=

# --- Cloudflare R2 (Fasa 6) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
